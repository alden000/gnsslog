{
  "name": "gnsslog",
  "version": "0.7.3",
  "private": true,
  "description": "PWA vessel position/heading logger with skyhook view",
  "type": "module",
  "scripts": {
    "start": "node server/dev-server.mjs",
    "receiver": "node server/receiver.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "node tests/e2e/smoke.mjs && node tests/e2e/resume.mjs && node tests/e2e/native-mock.mjs && node tests/e2e/offline.mjs",
    "icons": "node tools/render-icons.mjs && node tools/render-android-icons.mjs",
    "android:sync": "node tools/build-www.mjs && cap sync android"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "playwright": "1.56.1"
  },
  "dependencies": {
    "@capacitor-community/background-geolocation": "^1.2.26",
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/share": "^8.0.2"
  }
}
